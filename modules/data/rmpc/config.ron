#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    address: "127.0.0.1:6600",
    password: None,
    theme: "everforest-warm",
    cache_dir: None,
    on_song_change: None,
    volume_step: 5,
    max_fps: 30,
    scrolloff: 5,
    wrap_navigation: false,
    enable_mouse: true,
    enable_config_hot_reload: true,
    status_update_interval_ms: 1000,
    select_current_song_on_change: true,
    ignore_leading_the: false,
    browser_song_sort: [Disc, Track, Artist, Title],
    directories_sort: SortFormat(group_by_type: true, reverse: false),
    album_art: (
        method: Auto,
        max_size_px: (width: 1200, height: 1200),
        disabled_protocols: ["http://", "https://"],
        vertical_align: Center,
        horizontal_align: Center,
        // Per-station covers via custom loader (requires rmpc master / > 0.11.0);
        // master tilde-expands and resolves env vars in paths.
        custom_loader: ["~/.config/rmpc/scripts/radio_cover_loader"],
    ),
    cava: (
        framerate: 60,
        autosens: true,
        sensitivity: 100,
        input: (
            method: Fifo,
            source: "/tmp/mpd.fifo",
            sample_rate: 44100,
            channels: 2,
            sample_bits: 16,
        ),
        smoothing: (
            noise_reduction: 77,
            monstercat: true,
            waves: true,
        ),
    ),
    keybinds: (
        global: {
            "q":       Quit,
            "?":       ShowHelp,
            ":":       CommandMode,
            "z":       ToggleRepeat,
            "x":       ToggleRandom,
            "c":       ToggleConsume,
            "v":       ToggleSingle,
            "p":       TogglePause,
            "s":       Stop,
            ">":       NextTrack,
            "<":       PreviousTrack,
            "f":       SeekForward,
            "b":       SeekBack,
            ".":       VolumeUp,
            ",":       VolumeDown,
            "<Tab>":   NextTab,
            "<S-Tab>": PreviousTab,
            "1":       SwitchToTab("Player"),
            "2":       SwitchToTab("Radio"),
            "3":       SwitchToTab("Library"),
            "4":       SwitchToTab("Artists"),
            "5":       SwitchToTab("Albums"),
            "6":       SwitchToTab("Search"),
            "<C-u>":   Update,
            "<C-U>":   Rescan,
        },
        navigation: {
            "<C-c>":   Close,
            "<Esc>":   Close,
            "<CR>":    Confirm,
            "k":       Up,
            "<Up>":    Up,
            "j":       Down,
            "<Down>":  Down,
            "h":       Left,
            "<Left>":  Left,
            "l":       Right,
            "<Right>": Right,
            "gg":      Top,
            "G":       Bottom,
            "<Space>": Select,
            "/":       EnterSearch,
            "a":       Add,
            "A":       AddAll,
            "D":       Delete,
        },
        queue: {
            "d":    Delete,
            "D":    DeleteAll,
            "<CR>": Play,
            "C":    JumpToCurrent,
            "X":    Shuffle,
        },
    ),
    tabs: [
        (
            name: "Player",
            pane: Split(
                direction: Horizontal,
                panes: [
                    (
                        size: "40%",
                        borders: "ALL",
                        border_symbols: Rounded,
                        pane: Pane(AlbumArt),
                    ),
                    (
                        size: "60%",
                        pane: Split(
                            direction: Vertical,
                            panes: [
                                (
                                    size: "55%",
                                    borders: "ALL",
                                    border_symbols: Rounded,
                                    pane: Pane(Queue),
                                ),
                                (
                                    size: "45%",
                                    borders: "ALL",
                                    border_symbols: Rounded,
                                    pane: Pane(Cava),
                                ),
                            ],
                        ),
                    ),
                ],
            ),
        ),
        (
            name: "Radio",
            borders: "ALL",
            border_symbols: Rounded,
            pane: Pane(Playlists),
        ),
        (
            name: "Library",
            borders: "ALL",
            border_symbols: Rounded,
            pane: Pane(Directories),
        ),
        (
            name: "Artists",
            borders: "ALL",
            border_symbols: Rounded,
            pane: Pane(Artists),
        ),
        (
            name: "Albums",
            borders: "ALL",
            border_symbols: Rounded,
            pane: Pane(Albums),
        ),
        (
            name: "Search",
            borders: "ALL",
            border_symbols: Rounded,
            pane: Pane(Search),
        ),
    ],
)
